@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# libsymmetrix is typically a static library, so consumers also link its private
# dependencies. sphericart's package config does not look for OpenMP itself, so
# OpenMP has to be found first.
if("@OpenMP_CXX_FOUND@")
  find_dependency(OpenMP)
endif()
find_dependency(sphericart)
if("@SYMMETRIX_KOKKOS@")
  if(NOT TARGET Kokkos::kokkos)
    find_dependency(Kokkos)
  endif()
  if(NOT TARGET Kokkos::kokkoskernels)
    find_dependency(KokkosKernels)
  endif()
  if("@Kokkos_ENABLE_CUDA@")
    find_dependency(CUDAToolkit)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libsymmetrix-targets.cmake")
check_required_components(libsymmetrix)
